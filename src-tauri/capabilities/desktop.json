{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Google sign-in: its loopback flow only exists on desktop",
  "platforms": ["windows", "macOS", "linux"],
  "windows": [
    "main"
  ],
  "permissions": [
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://accounts.google.com/*" }] },
    "oauth:allow-start",
    "oauth:allow-cancel",
    { "identifier": "http:default", "allow": [{ "url": "https://oauth2.googleapis.com/token" }] }
  ]
}

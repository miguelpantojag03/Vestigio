{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What every platform needs",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "sql:default",
    "sql:allow-execute",
    { "identifier": "fs:allow-write-file", "allow": [{ "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-read-file",  "allow": [{ "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-mkdir",      "allow": [{ "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-remove",     "allow": [{ "path": "$APPLOCALDATA/**" }] },
    { "identifier": "fs:allow-exists",     "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-stat",       "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-copy-file",  "allow": [{ "path": "**" }] },
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] },
    "dialog:default",
    "process:allow-restart",
    "process:allow-exit"
  ]
}
